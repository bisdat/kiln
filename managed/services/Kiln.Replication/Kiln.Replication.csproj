<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/repl (kiln.repl): the network inspector (Replication: counters per peer and
       channel, watches on single entities, the repl commands, the Kiln menu's Replication section), read only, and on
       lab servers the loopback harness (ReplicationLab). Deployed to kiln/host/ and shared by every mod (mods reference
       it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <!-- NetPeer in the records; kiln.net's lab binding of a fake (NetNative, internal) -->
    <ProjectReference Include="../Kiln.Network/Kiln.Network.csproj" Private="false" />
    <!-- the repl commands -->
    <ProjectReference Include="../Kiln.Chat/Kiln.Chat.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Replication.Tests" />
    <!-- the Network page's Replication section (ReplicationView) -->
    <InternalsVisibleTo Include="Kiln.Ui" />
    <!-- the repl ops (Replication's own owner, the capture) -->
    <InternalsVisibleTo Include="Kiln.Admin" />
    <!-- the lab test's payloads, hook cost and lab-peer binding (ReplicationLabInternals) -->
    <InternalsVisibleTo Include="ReplTest" />
    <!-- the test kit's fake kiln.repl table -->
    <InternalsVisibleTo Include="Kiln.TestKit" />
  </ItemGroup>
</Project>
