<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.content: the managed face of native/services/content (registries + data packs: items, recipes, random loot,
       drop tables). Deployed to kiln/host/ and shared by every mod (mods reference it with Private="false"
       ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Blocks" />
    <!-- the item remap reads the declared look-alikes (NewContent.VanillaLooks) -->
    <InternalsVisibleTo Include="Kiln.Replication" />
    <InternalsVisibleTo Include="Kiln.Blocks.Tests" />
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
    <!-- the item icons' resolver (ItemIcons.cs): a new item's own GUID and the UI texture the game draws for it (ContentNames) -->
    <InternalsVisibleTo Include="Kiln.Ui" />
    <InternalsVisibleTo Include="Kiln.Ui.Tests" />
    <InternalsVisibleTo Include="Kiln.Items.Tests" />
    <InternalsVisibleTo Include="StationMenusTest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <ProjectReference Include="../Kiln.PlayerAnim/Kiln.PlayerAnim.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Items/Kiln.Items.csproj" Private="false" />
    <!-- content sync (ContentSync.cs): the kiln:content channel, client state -->
    <ProjectReference Include="../Kiln.Network/Kiln.Network.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Client/Kiln.Client.csproj" Private="false" />
    <!-- missing content (MissingContent.cs): every new item a world has seen is recorded in its WorldData -->
    <ProjectReference Include="../Kiln.Saves/Kiln.Saves.csproj" Private="false" />
  </ItemGroup>
</Project>
