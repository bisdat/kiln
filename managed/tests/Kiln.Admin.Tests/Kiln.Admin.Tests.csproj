<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of Kiln.Admin's own parts (mods/Kiln.Admin, internals visible): the file bridge's I/O thread (no disk
       access on the tick thread), the metrics topic, the one-time login mint, the restart countdown and its exit,
       command sources with a level cap. KAP itself is spoken over a real loopback socket. The protocol against a lab
       server: tools/nettest/kaptest.py. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591;KILNX002;xUnit1031;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" />
    <ProjectReference Include="../../services/Kiln.Chat/Kiln.Chat.csproj" />
    <ProjectReference Include="../../services/Kiln.Permissions/Kiln.Permissions.csproj" />
    <ProjectReference Include="../../services/Kiln.Players/Kiln.Players.csproj" />
    <ProjectReference Include="../../services/Kiln.Saves/Kiln.Saves.csproj" />
    <ProjectReference Include="../../../mods/Kiln.Admin/Kiln.Admin.csproj" />
  </ItemGroup>
</Project>
