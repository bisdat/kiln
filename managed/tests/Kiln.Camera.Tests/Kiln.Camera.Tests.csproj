<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln.Camera offline: the transport's wire codec and protocol state machines (Transport/) on a fake clock and a lossy
       fake link. Minimal file made by the S7 transport task; the S2 skeleton's version replaces it at the merge. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable><IsTestProject>true</IsTestProject><OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- not Kiln.Camera.Tests: a namespace Kiln.Camera would hide a class Kiln.Camera -->
    <RootNamespace>Kiln.CameraTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../services/Kiln.Camera/Kiln.Camera.csproj" />
  </ItemGroup>
</Project>
