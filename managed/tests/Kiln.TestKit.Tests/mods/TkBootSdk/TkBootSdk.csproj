<Project>
  <!-- tk-boot-sdk: a boot mod built with Kiln.Sdk (repository mode) and no kiln.mod.json of its own: <KilnBoot> alone opts it into
       the boot phase, so the analyzers must see the property (Kiln.Analyzers.targets, CompilerVisibleProperty) or KILN034 stops
       the build. BootFakeTests runs its OnBoot from the built folder, with the manifest the SDK wrote. -->
  <Import Project="../../../../Kiln.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <KilnModId>tk-boot-sdk</KilnModId>
    <KilnModName>Test kit boot mod (Kiln.Sdk)</KilnModName>
    <Version>0.1.0</Version>
    <KilnSide>server</KilnSide>
    <KilnServices>Blocks</KilnServices>
    <KilnGameIds>None</KilnGameIds>
    <KilnBoot>true</KilnBoot>
  </PropertyGroup>
  <Import Project="../../../../Kiln.Sdk/Sdk/Sdk.targets" />
  <!-- In repository mode the services' own project references land in the output; kiln/host has them (as TkWorld does). -->
  <Target Name="_TkBootSdkSharedOut" AfterTargets="_KilnModFiles">
    <ItemGroup>
      <_KilnModFile Remove="$(OutDir)Kiln.*" />
    </ItemGroup>
  </Target>
</Project>
