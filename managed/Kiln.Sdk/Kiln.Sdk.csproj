<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln.Sdk: the MSBuild SDK package for Kiln mods (Sdk/ props + targets) and its build task, Kiln.Sdk.Tasks.dll
       (tasks/net10.0/), which generates/validates kiln.mod.json with the loader's own parser (linked from Kiln.Host).
       Pack: managed/Kiln.Sdk/pack.sh. Inside the repository, mods using Sdk/ reference this project, which copies
       the task to $(KILN_OUT)/sdk-tasks/ (or .out/sdk-tasks/). -->
  <Import Project="Sdk/Kiln.Version.props" />
  <PropertyGroup>
    <AssemblyName>Kiln.Sdk.Tasks</AssemblyName>
    <RootNamespace>Kiln.Sdk</RootNamespace>
    <PackageId>Kiln.Sdk</PackageId>
    <Version>$(KilnSdkVersion)</Version>
    <PackageType>MSBuildSdk</PackageType>
    <Description>MSBuild SDK for Kiln (Enshrouded) mods: references Kiln.Api and services, generates and validates kiln.mod.json, KilnDeploy and KilnPack targets.</Description>
    <PackageTags>kiln;enshrouded;mod;msbuild-sdk</PackageTags>
    <BuildOutputTargetFolder>tasks</BuildOutputTargetFolder>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);packages/**;Sdk/**;native/**;bake/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Kiln.Host/Manifest.cs" Link="Shared/Manifest.cs" />
    <Compile Include="../Kiln.Host/SemVer.cs" Link="Shared/SemVer.cs" />
    <Compile Include="../Kiln.Host/KilnBuild.cs" Link="Shared/KilnBuild.cs" />
    <!-- KilnBakeClean reads baked files as the game does (bounded) -->
    <Compile Include="../Kiln.Api/BakedFiles.cs" Link="Shared/BakedFiles.cs" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" PrivateAssets="all" ExcludeAssets="runtime" />
    <None Include="Sdk/*.props;Sdk/*.targets" Exclude="Sdk/Kiln.Version.props" Pack="true" PackagePath="Sdk/" />
    <!-- The package's own Kiln.Version.props names the package's version (pack.sh: -p:KilnSdkVersion=<full version>), so
         Kiln.Mod.targets restores the Kiln.Api of the same pack. -->
    <None Include="$(IntermediateOutputPath)Kiln.Version.props" Pack="true" PackagePath="Sdk/" Visible="false" />
  </ItemGroup>
  <Target Name="KilnStampVersion" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <WriteLinesToFile File="$(IntermediateOutputPath)Kiln.Version.props" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;;  &lt;!-- Written when this Kiln.Sdk was packed: its version, and the Kiln.Api version it restores. --&gt;;  &lt;PropertyGroup&gt;;    &lt;KilnSdkVersion&gt;$(KilnSdkVersion)&lt;/KilnSdkVersion&gt;;    &lt;KilnModApiVersion&gt;$(KilnModApiVersion)&lt;/KilnModApiVersion&gt;;  &lt;/PropertyGroup&gt;;&lt;/Project&gt;" />
  </Target>
  <!-- Roslyn components (pack.sh builds them into KilnAnalyzersStage): Kiln.Analyzers + Kiln.Analyzers.CodeFixes
       (KILN1xx, wired by Sdk/Kiln.Analyzers.targets), Kiln.GameIds (Sdk/Kiln.GameIds.targets) and Kiln.Sigs.Generator
       (Sdk/Kiln.Sigs.targets), under
       analyzers/dotnet/cs/. -->
  <ItemGroup Condition="'$(KilnAnalyzersStage)' != ''">
    <None Include="$(KilnAnalyzersStage)/Kiln.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="$(KilnAnalyzersStage)/Kiln.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="$(KilnAnalyzersStage)/Kiln.GameIds.dll" Condition="Exists('$(KilnAnalyzersStage)/Kiln.GameIds.dll')"
          Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="$(KilnAnalyzersStage)/Kiln.Sigs.Generator.dll" Condition="Exists('$(KilnAnalyzersStage)/Kiln.Sigs.Generator.dll')"
          Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="$(KilnAnalyzersStage)/Kiln.ImpactNatives.dll" Condition="Exists('$(KilnAnalyzersStage)/Kiln.ImpactNatives.dll')"
          Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
  </ItemGroup>
  <!-- The bake (bake/ in the package; pack.sh builds it into KilnBakeStage): Kiln.Sdk.Bake, Kiln.Host, Kiln.TestKit and their
       dependencies, run by Sdk/Kiln.Bake.targets beside Kiln.Api's kiln/lib (docs/kiln/modding/baked.md). -->
  <ItemGroup Condition="'$(KilnBakeStage)' != ''">
    <None Include="$(KilnBakeStage)/*" Pack="true" PackagePath="bake/" Visible="false" />
  </ItemGroup>
  <!-- The native SDK (native/ in the package; KILN_SDK_DIR for kiln_plugin, docs/kiln/modding/mdk.md "Native mods"):
       KilnPlugin.cmake, the C ABI headers and the real Linux toolchain. The repository's native/cmake/clang-cl-xwin.cmake
       replaces the wrapper of the same name that managed/Kiln.Sdk/native/cmake has for in-repository builds.
       The headers are Kiln's public C ABI only: kiln.launch (the start's ShroudForge backend, which Kiln's own loaders
       read) and kiln-eml's startup seams (kiln.eml.archive, kiln.eml.values, kiln.eml.startup) stay out, and so does
       every "kiln-internal begin" ... "kiln-internal end" block of the others (members Kiln keeps to itself in this
       release, such as kiln.client's building input): KilnStageAbiHeaders writes the
       headers without those blocks into obj/ and packs that copy. native/core/tests/test-abi-headers.sh checks the
       stripped view of the headers that have such blocks. -->
  <ItemGroup>
    <None Include="native/cmake/KilnPlugin.cmake" Pack="true" PackagePath="native/cmake/" />
    <None Include="../../native/cmake/clang-cl-xwin.cmake" Pack="true" PackagePath="native/cmake/" Visible="false" />
    <KilnAbiHeader Include="../../native/core/abi/**/*.h;../../native/core/abi/**/*.hpp"
                   Exclude="../../native/core/abi/services/kiln_launch.h;../../native/core/abi/services/kiln_eml_*.h" />
  </ItemGroup>
  <UsingTask TaskName="KilnStripInternal" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Headers ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDir ParameterType="System.String" Required="true" />
      <Written ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // A "kiln-internal begin" line, every line after it and the "kiln-internal end" line go; blocks never nest.
        var begin = new Regex(@"^\s*(/\*|//)\s*kiln-internal begin");
        var end = new Regex(@"^\s*(/\*|//)\s*kiln-internal end");
        var written = new List<ITaskItem>();
        foreach (var header in Headers) {
          var source = header.GetMetadata("FullPath");
          var relative = (header.GetMetadata("RecursiveDir") ?? "").Replace('\\', '/');
          var name = header.GetMetadata("Filename") + header.GetMetadata("Extension");
          var kept = new List<string>();
          var open = 0;
          var lines = File.ReadAllLines(source);
          for (var i = 0; i < lines.Length; i++) {
            if (begin.IsMatch(lines[i])) {
              if (open != 0) { Log.LogError("{0}:{1}: a kiln-internal begin inside the block that begins at line {2}", source, i + 1, open); return false; }
              open = i + 1;
              continue;
            }
            if (end.IsMatch(lines[i])) {
              if (open == 0) { Log.LogError("{0}:{1}: a kiln-internal end without a begin", source, i + 1); return false; }
              open = 0;
              continue;
            }
            if (open == 0) kept.Add(lines[i]);
          }
          if (open != 0) { Log.LogError("{0}:{1}: a kiln-internal begin without an end", source, open); return false; }
          var target = Path.Combine(OutputDir, relative, name);
          Directory.CreateDirectory(Path.GetDirectoryName(target));
          File.WriteAllText(target, string.Join("\n", kept) + "\n");
          var item = new TaskItem(target);
          item.SetMetadata("PackagePath", "native/include/" + relative);
          written.Add(item);
        }
        Written = written.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="KilnStageAbiHeaders" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <RemoveDir Directories="$(IntermediateOutputPath)kiln-abi" />
    <KilnStripInternal Headers="@(KilnAbiHeader)" OutputDir="$(IntermediateOutputPath)kiln-abi">
      <Output TaskParameter="Written" ItemName="_KilnAbiStaged" />
    </KilnStripInternal>
    <ItemGroup>
      <None Include="@(_KilnAbiStaged)" Pack="true" Visible="false" />
    </ItemGroup>
  </Target>
  <!-- Repository mode: a fixed task location the mods' UsingTask can name at evaluation time. -->
  <PropertyGroup>
    <KilnSdkTasksDir Condition="'$(KILN_OUT)' != ''">$([MSBuild]::NormalizeDirectory('$(KILN_OUT)', 'sdk-tasks'))</KilnSdkTasksDir>
    <KilnSdkTasksDir Condition="'$(KILN_OUT)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '.out', 'sdk-tasks'))</KilnSdkTasksDir>
  </PropertyGroup>
  <Target Name="KilnCopyTasks" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KilnSdkTasksDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
