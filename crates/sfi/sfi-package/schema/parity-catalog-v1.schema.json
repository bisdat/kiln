{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frostdev.io/kiln/sfi/parity-catalog-v1.schema.json",
  "title": "Kiln SFI parity catalog, format 1",
  "description": "Emitted only by the aggregate proof exporter from one successful live run. digest = lowercase SHA-256 of the canonical compact JSON of {schema_version, header, symbols} (field order as listed here, digest excluded). A schema_version change needs an explicit consumer compatibility decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "header", "symbols", "digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "header": { "$ref": "#/$defs/header" },
    "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
    "digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision_id": { "enum": ["sf179", "sf180"] },
    "scope": { "enum": ["root-global", "namespace-member", "userdata-member", "returned-field", "type-declaration", "contract-data"] },
    "presence": { "enum": ["callable", "value", "declaration", "absent", "not-in-revision", "n/a", "unknown"] },
    "parity": { "enum": ["full", "partial", "missing", "excluded"] },
    "alias_relation": { "enum": ["delegate", "namespace-identity"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "partial", "missing", "n/a"],
      "properties": {
        "full": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "n/a": { "type": "integer", "minimum": 0 }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "revisions", "final_manifest_sha256", "frozen", "policy_sha256", "registry_sha256", "backend_build", "evidence", "symbol_obligations", "other_obligations"],
      "properties": {
        "format": { "const": "kiln-sfi-parity-catalog" },
        "revisions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source_version", "source_pin", "inventory_sha256"],
            "properties": {
              "id": { "$ref": "#/$defs/revision_id" },
              "source_version": { "enum": ["1.7.9", "1.8.0"] },
              "source_pin": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "inventory_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "final_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "frozen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "sha256"],
            "properties": { "family": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "registry_sha256": { "$ref": "#/$defs/sha256" },
        "backend_build": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "modules", "runtime_modules", "assertions", "mappings", "sha256"],
          "properties": {
            "scope": { "const": "aggregate" },
            "modules": { "type": "integer", "minimum": 0 },
            "runtime_modules": { "type": "integer", "minimum": 0 },
            "assertions": { "type": "integer", "minimum": 0 },
            "mappings": { "type": "integer", "minimum": 0 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "symbol_obligations": { "$ref": "#/$defs/counts" },
        "other_obligations": { "$ref": "#/$defs/counts" }
      }
    },
    "symbol_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "presence", "parity", "required", "proven_full", "tests", "digest"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision_id" },
        "presence": { "$ref": "#/$defs/presence" },
        "parity": { "$ref": "#/$defs/parity" },
        "required": { "type": "integer", "minimum": 0 },
        "proven_full": { "type": "integer", "minimum": 0 },
        "tests": { "type": "array", "items": { "type": "string" } },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "composite_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "milestone", "revisions"],
      "properties": {
        "id": { "type": "string" },
        "owner": { "type": "string" },
        "milestone": { "type": "string" },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision", "parity", "digest"],
            "properties": {
              "revision": { "$ref": "#/$defs/revision_id" },
              "parity": { "$ref": "#/$defs/parity" },
              "digest": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "kind", "introduced", "alias_of", "revisions", "composite"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "kind": { "type": "string", "minLength": 1 },
        "introduced": { "type": ["string", "null"], "enum": ["1.7.9", "1.8.0", null] },
        "alias_of": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "relation"],
              "properties": { "target": { "type": "string" }, "relation": { "$ref": "#/$defs/alias_relation" } }
            }
          ]
        },
        "revisions": { "type": "array", "items": { "$ref": "#/$defs/symbol_revision" } },
        "composite": { "type": "array", "items": { "$ref": "#/$defs/composite_part" } }
      }
    }
  }
}
