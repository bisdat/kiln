{
  "regmap": 1,
  "registry": "items",
  "entries": {
    "kind": "resource",
    "resourceType": "keen::ItemInfo",
    "name": "debugName",
    "guid": "objectId",
    "id": "itemId",
    "unnamed": "item_%08x"
  },
  "rows": {
    "maxStack": {
      "paths": [
        "maxStackSize"
      ],
      "conv": "int",
      "read": "worldLoad",
      "backend": "live",
      "clientNeeds": true,
      "evidence": "docs/re/content.md: StackClamp reads +0x14 at each transaction; a lowering cuts stacks at save load"
    },
    "rarity": {
      "paths": [
        "rarity"
      ],
      "conv": "enum",
      "read": "now",
      "backend": "live",
      "values": {
        "common": "Common",
        "uncommon": "Uncommon",
        "rare": "Rare",
        "epic": "Epic",
        "legendary": "Legendary"
      },
      "clientNeeds": true,
      "evidence": "docs/re/items.md: createPide and the recipe tooltip read it per new copy"
    },
    "rolled": {
      "paths": [
        "generateRarity"
      ],
      "conv": "bool",
      "read": "now",
      "backend": "live",
      "evidence": "docs/re/items.md: createPide and rebalance_perks_and_level read it"
    },
    "levels.min": {
      "paths": [
        "itemLevelRange.minLevel"
      ],
      "conv": "int",
      "read": "now",
      "backend": "live",
      "clientNeeds": true,
      "evidence": "docs/re/items.md: new copies; a save load re-clamps copies into the range"
    },
    "levels.max": {
      "paths": [
        "itemLevelRange.maxLevel"
      ],
      "conv": "int",
      "read": "now",
      "backend": "live",
      "clientNeeds": true,
      "evidence": "docs/re/items.md"
    },
    "socket": {
      "paths": [
        "gemSlotOverride.isSet"
      ],
      "conv": "bool",
      "read": "now",
      "backend": "live",
      "evidence": "docs/kiln/services/gems-sockets.md: createPide gives the slot when it is set"
    },
    "perks": {
      "paths": [
        "perkReferences",
        "perkIds"
      ],
      "conv": "refList",
      "read": "now",
      "backend": "live",
      "clientNeeds": true,
      "evidence": "docs/re/content.md: perkIds read by rebalance_perks_and_level; perkReferences per new copy"
    },
    "power": {
      "paths": [
        "damageSetup.dmgMod",
        "damageSetup.speedMod",
        "itemLevelRange.minLevel"
      ],
      "conv": "formula",
      "read": "now",
      "backend": "live",
      "formula": "gear.power",
      "clientNeeds": true,
      "evidence": "docs/re/items.md: impact_initialize computes power per impact; the client tooltip from its own registry"
    },
    "speed": {
      "paths": [
        "damageSetup.speedMod"
      ],
      "conv": "float",
      "read": "now",
      "backend": "live",
      "clientNeeds": true,
      "evidence": "docs/re/items.md: the same reader as power"
    },
