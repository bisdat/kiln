<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lab test (package P7 of the equipment wave): per-instance values on a real server, player-free, over two boots of one
       lab: a level outside the type's range (Items.SetLevel with AnyLevel), a max durability (Items.SetDurabilityMax), the
       power and armour multipliers (Items.SetPower / SetArmor: kiln.items v8 gear_scale, whose first call installs the
       hooks), then a save; the second boot checks Kiln wrote every value again after the load (Kiln.Blocks'
       GearKeepRuntime, item data "kiln-gear:values"). docs/kiln/services/items.md "Per-instance values". -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Items/Kiln.Items.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Saves/Kiln.Saves.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.World/Kiln.World.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Spawn/Kiln.Spawn.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
