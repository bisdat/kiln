.kimp 1
; gems-custom-test: one hit through the game's applyDamage, from the root (the attacker) to a target, with a weapon
; category and a damage setup chosen by the test (perkhit-test's hit program with its damage as a config). The game's
; hit conclusion turns it into a HitEvent, which is what the gem trigger programs read (forEachHitEvent).
; Assemble: python3 tools/impact/impact.py asm impact/hit.kimp -o assets/hit.bin
program 531786a3-5547-4ad0-a433-b878a3c08124
stack 256
streams none

var $damage    impact.DamageSetup config "gemtest.Damage" = {physicalCutDamage: 5.0}
var $attacker  ecs.EntityId
var $target    ecs.EntityId config "gemtest.Target"
var $weapon    WeaponCategoryReference config "gemtest.Weapon"
var $blocked   bool
var $at        float3 config "gemtest.At"
var $normal    float3
var $direction impact.MajorDirection
var $attackMod float32 = 1.0
var $stamina   float32 = 1.0
var $noise     float32 = 0.0
var $push      impact.PushBackForce = Small
var $reaction  impact.HitReactionType = Light
var $category  impact.AttackCategoryMask = [Melee]
var $material  MaterialFeedbackId
var $canBlock  bool = false
var $gain      sint32 = 0
var $scale     AttributeReference
var $repeat    bool = true

code:
        ecall getRoot($attacker)
        pop
        ecall applyDamage($blocked, $attacker, $target, $at, $normal, $direction, $attackMod, $stamina, $noise, _, $gain, $scale, $push, $reaction, $damage, $category, $weapon, $material, _, $canBlock, _, _, _, $repeat, _)
        brt landed
        ecall kiln.Signal($attacker, 0x700)
        pop
        halt
landed: ecall kiln.Signal($attacker, 0x701)
        pop
        halt

shutdown:
        halt
