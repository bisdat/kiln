<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lab test of the game-program surface (chapter 06a; docs/kiln/services/systems.md). Player-free. The managed
       part checks Kiln.Testing.LabSystems (the lab parallel switch) and Kiln.Systems; the native part (native/,
       kiln-systems-test.dll in kiln/plugins) checks kiln.world's C table. Both print PASS/FAIL lines to kiln.log; the
       lab needs kiln/control/systems.parallel. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- LabSystems is a lab member (KILNX001) -->
    <NoWarn>$(NoWarn);KILNX001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/Kiln.Testing/Kiln.Testing.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Systems/Kiln.Systems.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- ComponentWrittenEvent: a wrap's writes through entity views -->
    <ProjectReference Include="../../../managed/services/Kiln.World/Kiln.World.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- the well of the AroundEach row -->
    <ProjectReference Include="../../../managed/services/Kiln.Spawn/Kiln.Spawn.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- the typed program views (Ecs.Programs.FuelSetup) and Ecs.Get -->
    <ProjectReference Include="../../../managed/Kiln.Game/Kiln.Game.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="native/**;Peer/**" />
  </ItemGroup>
</Project>
