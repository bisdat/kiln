<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lab test (package P4 of the equipment wave): the upgrade station on a real server, player-free. The prop's template and
       its interaction entry; the station's use run with a chest standing in for the player (its hand is the test's: Items.Held
       needs a player); the window's dry-run prices and its pick checks (the server's own list, the range, the inventory).
       The interaction from a real player is the client check equip.c1. docs/kiln/modding/world-blocks.md "Upgrade stations".
       Build: dotnet build mods/tests/upgrade-station-test/UpgradeStationTest.csproj -c Release -o $KILN_OUT/mods/upgrade-station-test -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>UpgradeStationTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Items/Kiln.Items.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Blocks/Kiln.Blocks.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Content/Kiln.Content.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.World/Kiln.World.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Build/Kiln.Build.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
