<Project Sdk="Microsoft.NET.Sdk">
  <!-- gamedata-test's buff room (chapter 17.2): 4,097 buff clones from one mod, 2,000 defined before the world and 2,097
       in one data-pack document while it runs; the 4,097th is refused, the world's load and the running document
       publish one header each, a GUID whose buff id is another clone's is refused. A separate mod so a lab can run it
       alone (the header counts are this mod's). PASS / FAIL lines "gamedata-caps: ..." in kiln.log. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../../managed/services/Kiln.Content/Kiln.Content.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
