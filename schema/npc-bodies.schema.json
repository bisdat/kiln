{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kiln deferred NPC body bundle v1",
  "description": "Generated by the cook tools for bootpack only; never an eager assets.json manifest. Complete means cooked, not committed or Ready. Material-block hashes do not prove material publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "entries", "bodies"],
  "properties": {
    "format": { "const": 1 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "bodies": { "type": "object", "additionalProperties": { "$ref": "#/$defs/body" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": { "type": "string", "pattern": "^assets/cooked/[^\\\\]+$" },
    "dependency": {
      "type": "object", "additionalProperties": false, "required": ["file", "sha256"],
      "properties": { "file": { "type": "string" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "file", "sha256", "producer", "sourceHash"],
      "properties": {
        "kind": { "enum": ["resource", "blob"] },
        "file": { "$ref": "#/$defs/file" },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "sourceHash": { "$ref": "#/$defs/hash" },
        "producer": { "enum": ["animcook", "modelcook"] },
        "guid": { "type": "string", "format": "uuid" },
        "type": { "type": "string" },
        "part": { "type": "integer", "minimum": 0 },
        "mode": { "const": "new" },
        "patch": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["offset", "blob"],
            "properties": { "offset": { "type": "integer", "minimum": 0 }, "blob": { "$ref": "#/$defs/file" } }
          }
        }
      },
      "allOf": [{ "if": { "properties": { "kind": { "const": "resource" } } }, "then": { "required": ["guid", "type", "part", "mode"] } }]
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "variant", "state", "durationNs", "loop", "clamp"],
      "properties": {
        "role": { "enum": ["sit", "sleep", "inspect", "greet", "talk", "reaction0", "reaction1", "refuse", "idleGesture0", "idleGesture1", "interaction", "greetingExtra", "farewell", "dialogOption", "attentionGreeting", "turnLeftSmall", "turnLeftBig", "turnRightSmall", "turnRightBig", "jump", "door"] },
        "variant": { "type": "integer", "minimum": 0, "maximum": 2 },
        "state": { "type": "string", "format": "uuid" },
        "interactionKey": { "type": "string", "format": "uuid" },
        "durationNs": { "type": "integer", "minimum": 1 },
        "loop": { "type": "boolean" }, "clamp": { "type": "boolean" }
      }
    },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "spec", "model", "graph", "skeleton", "bindings", "materialBlocks", "files", "complete"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "spec": {
          "type": "object", "additionalProperties": false,
          "required": ["key", "body", "animation", "motions", "skeletonName", "graphName", "modelName"],
          "properties": {
            "key": { "type": "string" }, "body": { "$ref": "kiln-blocks.schema.json#/$defs/body" },
            "animation": { "$ref": "kiln-blocks.schema.json#/$defs/animation" }, "motions": { "$ref": "kiln-blocks.schema.json#/$defs/npcMotions" },
            "skeletonName": { "type": "string" }, "animationName": { "type": "string", "description": "The private animation block's unbound base graph name." },
            "bodyName": { "type": "string", "description": "The private body block name used by slot-bound graph variants." },
            "graphName": { "type": "string" }, "modelName": { "type": "string" }
          }
        },
        "model": { "type": ["string", "null"], "format": "uuid" },
        "graph": { "type": ["string", "null"], "format": "uuid" },
        "skeleton": { "type": ["string", "null"], "format": "uuid" },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" }, "maxItems": 27 },
        "materialBlocks": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "files": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "complete": { "type": "boolean" }
      }
    }
  }
}
