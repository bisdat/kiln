{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eml-archive/attribute-catalog.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pin": {
      "$ref": "common.schema.json#/$defs/pin"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/attribute_entry"
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/value"
      }
    }
  },
  "required": [
    "schema_version",
    "pin",
    "entries",
    "layouts"
  ],
  "additionalProperties": false
}
