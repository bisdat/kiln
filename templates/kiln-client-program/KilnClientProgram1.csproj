<Project Sdk="Kiln.Sdk/KILN_SDK_VERSION">
  <!-- A client program: kiln.programs.json declares it for the client world ("world": "client"), EcsPrograms.TryBind gives
       it its code on the game's main thread, Client.Tick reads what it counted. Docs: docs/kiln/services/world.md "Client world programs".
       Build: the output folder is the mod folder (KilnClientProgram1.dll + generated kiln.mod.json).
         dotnet build -t:KilnPack                                                       <id>-<version>.zip
       Every property is documented in Kiln.Sdk's Sdk/Kiln.Mod.targets and docs/kiln/modding/mdk.md. -->
  <PropertyGroup>
    <KilnModId>kiln-mod-id</KilnModId>
    <KilnModName>KilnClientProgram1</KilnModName>
    <Version>0.1.0</Version>
    <Description>KilnClientProgram1, a Kiln mod.</Description>
    <!-- <PackageLicenseExpression>MIT</PackageLicenseExpression>   the licence others may use it under (kiln.mod.json "license") -->
    <!-- A client mod: it loads in the game client's main menu, never on a server. Players joining you need nothing. -->
    <KilnSide>client</KilnSide>
    <KilnClients>none</KilnClients>
    <!-- Kiln service assemblies this mod uses (they ship with Kiln, never with the mod). -->
    <KilnServices>Client</KilnServices>
<!--#if (hasServer)-->
    <KilnServer>KILN_SERVER</KilnServer>
<!--#endif-->
  </PropertyGroup>
</Project>
