<Project Sdk="Kiln.Sdk/KILN_SDK_VERSION">
  <!-- A system wrap: your code before, after or around one of the game's own ECS programs, through the typed view
       Kiln.Game generates for it. Docs: docs/kiln/services/systems.md.
       Build: the output folder is the mod folder (KilnSystemWrap1.dll + generated kiln.mod.json).
         dotnet build -t:KilnDeploy -p:KilnServer=<server folder> [-p:KilnReload=true]   copy into <server>/kiln/mods/<id>
         dotnet build -t:KilnPack                                                       <id>-<version>.zip
       Every property is documented in Kiln.Sdk's Sdk/Kiln.Mod.targets and docs/kiln/modding/mdk.md. -->
  <PropertyGroup>
    <KilnModId>kiln-mod-id</KilnModId>
    <KilnModName>KilnSystemWrap1</KilnModName>
    <Version>0.1.0</Version>
    <Description>KilnSystemWrap1, a Kiln mod.</Description>
    <!-- <PackageLicenseExpression>MIT</PackageLicenseExpression>   the licence others may use it under (kiln.mod.json "license") -->
    <!-- Kiln service assemblies this mod uses (they ship with Kiln, never with the mod): Systems for the wrap, Game for
         the typed view of the program. -->
    <KilnServices>Systems;Game</KilnServices>
<!--#if (hasServer)-->
    <KilnServer>KILN_SERVER</KilnServer>
<!--#endif-->
  </PropertyGroup>
</Project>
